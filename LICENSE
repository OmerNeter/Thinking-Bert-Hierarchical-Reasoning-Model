const MIN_PROTECTED_TURNS = 2
const MAX_PART_PCT_OF_LIMIT = 0.45
const MAX_PART_ABS_TOKENS = 80_000
const CHARS_PER_TOKEN = 3.0
const MESSAGE_OVERHEAD = 20
const EMERGENCY_TARGET_PCT = 0.80
const RUNNING_SUMMARY_MAX_CHARS = 6000
const SECTION_MAX_ENTRIES = 14
const MAX_RETRIEVE_CHARS_DEFAULT = 80_000
const MAX_RETRIEVE_CHARS_HARD = 250_000
const MAX_INDEX_SHOWN = 60
const MAX_INDEX_SHOWN_IN_NOTICE = 20
